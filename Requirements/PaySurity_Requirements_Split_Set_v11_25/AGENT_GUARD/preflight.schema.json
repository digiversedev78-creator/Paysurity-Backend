{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PaySurity Requirement Schema",
  "type": "object",
  "required": [
    "ref",
    "domain",
    "phase",
    "priority",
    "type",
    "acceptance_criteria"
  ],
  "properties": {
    "ref": {
      "type": "string",
      "pattern": "^PSR-(V6|EXT)-[A-Z0-9\\-]+$"
    },
    "domain": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "enum": [
        "Phase 1",
        "Phase 2",
        "Phase 3"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "Must",
        "Should",
        "Could"
      ]
    },
    "type": {
      "type": "string",
      "enum": [
        "functional",
        "architectural",
        "integration",
        "security",
        "compliance",
        "operational"
      ]
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1
    }
  }
}
