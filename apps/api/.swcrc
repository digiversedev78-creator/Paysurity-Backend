{
  "jsc": {
    "parser": { "syntax": "typescript", "decorators": true, "dynamicImport": true },
    "transform": {
      "legacyDecorator": true,
      "decoratorMetadata": true
    },
    "target": "es2021",
    "keepClassNames": true
  },
  "module": { "type": "commonjs" },
  "exclude": [
    ".*\\.spec\\.ts$",
    ".*\\.spec\\.js$",
    ".*edge-cases\\.spec\\.ts$",
    ".*\\.test\\.ts$"
  ]
}
