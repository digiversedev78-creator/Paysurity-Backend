# PaySurity API Environment Configuration Example

# --- Application Configuration ---
# REQUIRED: The port on which the API server will listen.
PORT=3000

# REQUIRED: Node.js environment mode (e.g., development, production, test).
NODE_ENV=development

# OPTIONAL: Application-specific environment name (e.g., local, dev, staging, production).
# This can be more granular than NODE_ENV for internal tooling or logging.
APP_ENV=local

# REQUIRED: A unique name for this service instance. Used in logs, metrics, and distributed tracing.
SERVICE_NAME=paysurity-api

# OPTIONAL: The minimum level for logs to be displayed (e.g., debug, info, warn, error, fatal, silent).
LOG_LEVEL=info

# --- Database Configuration (PostgreSQL) ---
# REQUIRED: Connection URL for the PostgreSQL database.
# Format: postgresql://user:password@host:port/database?schema=public
# Example for local development: postgresql://paysurity_user:paysurity_password@localhost:5432/paysurity_dev
DATABASE_URL="postgresql://paysurity_user:YOUR_DATABASE_PASSWORD@localhost:5432/paysurity_dev"

# OPTIONAL: Controls whether Drizzle ORM should automatically sync database schema on application start.
# Set to 'true' ONLY in development and test environments for convenience. NEVER in production.
DATABASE_SYNC=false

# OPTIONAL: Enable SSL for database connections. Set to 'true' in production environments.
DATABASE_SSL_ENABLED=false

# OPTIONAL: Maximum number of connections in the database connection pool. Default is typically 10.
DATABASE_POOL_SIZE=10

# --- Authentication Service Configuration (External PaySurity Auth) ---
# REQUIRED: The base URL of the PaySurity Authentication Service.
# This API relies on an external service for user authentication and authorization.
AUTH_SERVICE_URL="http://localhost:3001"

# REQUIRED: Client ID for this API to identify itself with the Authentication Service.
AUTH_SERVICE_CLIENT_ID="paysurity-api-client"

# REQUIRED: Client Secret for this API to authenticate itself with the Authentication Service.
# This secret is used for machine-to-machine communication if the auth service requires it.
AUTH_SERVICE_CLIENT_SECRET="YOUR_AUTH_SERVICE_CLIENT_SECRET"

# REQUIRED: Secret key used to sign and verify JSON Web Tokens (JWTs) issued by the Auth Service.
# This should be a strong, randomly generated string, ideally 32+ characters.
JWT_SECRET="YOUR_JWT_SECRET_STRING_AT_LEAST_32_CHARS"

# OPTIONAL: Expected audience for JWTs. Used to validate tokens received from the Auth Service.
JWT_AUDIENCE="paysurity-api"

# OPTIONAL: Expected issuer of JWTs. Used to validate tokens received from the Auth Service.
JWT_ISSUER="paysurity-auth-service"

# OPTIONAL: The header name used for API Key authentication for internal or service-to-service communication.
# If using, ensure `API_KEY_HEADER_VALUE` is also set for clients.
API_KEY_HEADER_NAME="x-api-key"

# OPTIONAL: The expected value for the API key header. Should be a strong secret.
API_KEY_HEADER_VALUE="YOUR_INTERNAL_API_KEY_SECRET"

# --- Payment Gateway Integrations ---
# These variables configure connections to external payment processors.
# Specific gateways required depend on features enabled for a tenant.

# OPTIONAL (Stripe): Stripe API secret key. Used for making server-side API calls to Stripe.
STRIPE_SECRET_KEY="sk_test_YOUR_STRIPE_SECRET_KEY"

# OPTIONAL (Stripe): Stripe webhook signing secret. Used to verify the authenticity of incoming Stripe webhooks.
STRIPE_WEBHOOK_SECRET="whsec_YOUR_STRIPE_WEBHOOK_SECRET"

# OPTIONAL (Stripe): Publicly exposed key for client-side integrations (e.g., Stripe Elements).
STRIPE_PUBLISHABLE_KEY="pk_test_YOUR_STRIPE_PUBLISHABLE_KEY"

# OPTIONAL (PayPal): PayPal API client ID.
PAYPAL_CLIENT_ID="YOUR_PAYPAL_CLIENT_ID"

# OPTIONAL (PayPal): PayPal API secret key.
PAYPAL_SECRET_KEY="YOUR_PAYPAL_SECRET_KEY"

# OPTIONAL (PayPal): PayPal API environment (e.g., sandbox, live).
PAYPAL_ENVIRONMENT="sandbox"

# OPTIONAL (Square): Square API access token.
SQUARE_ACCESS_TOKEN="YOUR_SQUARE_ACCESS_TOKEN"

# OPTIONAL (Square): Square API environment (e.g., sandbox, production).
SQUARE_ENVIRONMENT="sandbox"

# OPTIONAL (Braintree): Braintree Merchant ID.
BRAINTREE_MERCHANT_ID="YOUR_BRAINTREE_MERCHANT_ID"

# OPTIONAL (Braintree): Braintree Public Key.
BRAINTREE_PUBLIC_KEY="YOUR_BRAINTREE_PUBLIC_KEY"

# OPTIONAL (Braintree): Braintree Private Key.
BRAINTREE_PRIVATE_KEY="YOUR_BRAINTREE_PRIVATE_KEY"

# OPTIONAL (Braintree): Braintree environment (e.g., sandbox, production).
BRAINTREE_ENVIRONMENT="sandbox"

# --- Email Service Configuration ---
# OPTIONAL: Provider for transactional email service (e.g., SendGrid, Mailgun, SMTP).
EMAIL_SERVICE_PROVIDER="SendGrid"

# OPTIONAL: API key for a transactional email service (e.g., SendGrid, Mailgun) for sending notifications.
EMAIL_SERVICE_API_KEY="YOUR_EMAIL_SERVICE_API_KEY"

# OPTIONAL: The default 'from' email address for outgoing notifications.
EMAIL_FROM="no-reply@paysurity.com"

# --- Cloud Storage Configuration (AWS S3 Example) ---
# REQUIRED (if using S3): AWS Region where the S3 bucket is located (e.g., us-east-1).
AWS_REGION="us-east-1"

# REQUIRED (if using S3): AWS Access Key ID with permissions for S3.
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"

# REQUIRED (if using S3): AWS Secret Access Key corresponding to the Access Key ID.
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"

# REQUIRED (if using S3): Name of the S3 bucket to use for storing files.
AWS_S3_BUCKET_NAME="paysurity-storage-dev"

# OPTIONAL (if using S3 compatible storage): Custom endpoint for S3-compatible storage (e.g., MinIO).
# AWS_S3_ENDPOINT="http://localhost:9000"

# --- Caching Configuration (Redis Example) ---
# OPTIONAL (if using Redis): Connection URL for the Redis server.
# Format: redis://[[username][:password]@][host][:port][/db-number]
REDIS_URL="redis://localhost:6379/0"

# OPTIONAL (if using Redis): Default Time-To-Live (TTL) in seconds for cached items.
REDIS_TTL_SECONDS=3600

# --- Message Queue Configuration (RabbitMQ / Kafka Example) ---
# OPTIONAL (if using a message queue): Connection URL for the message queue server.
# Format for RabbitMQ: amqp://user:password@host:port/vhost
# MESSAGE_QUEUE_URL="amqp://guest:guest@localhost:5672"

# OPTIONAL (if using a message queue): Type of message queue (e.g., RabbitMQ, Kafka).
# MESSAGE_QUEUE_TYPE="RabbitMQ"

# --- Feature Flag / Tenant Configuration Service ---
# OPTIONAL: Base URL for an external service that manages feature flags or tenant-specific configurations.
# FEATURE_FLAG_SERVICE_URL="http://localhost:3005"

# --- Monitoring and Tracing (OpenTelemetry / Sentry) ---
# OPTIONAL (if using OpenTelemetry): OTLP collector endpoint for exporting traces and metrics.
# OTEL_EXPORTER_OTLP_ENDPOINT="http://localhost:4318"

# OPTIONAL (if using Sentry): Sentry DSN (Data Source Name) for error monitoring.
# SENTRY_DSN="https://YOUR_SENTRY_PUBLIC_KEY@oYOUR_SENTRY_ORG_ID.ingest.sentry.io/YOUR_SENTRY_PROJECT_ID"