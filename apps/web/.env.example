# PaySurity — Public Website Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local development
# For staging: set these in your CI/CD pipeline or Vercel/Railway env dashboard

# ── API Endpoint (NestJS backend) ─────────────────────────────────────────────
# Local:   http://localhost:4000
# Staging: https://api.staging.paysurity.com
# Prod:    https://api.paysurity.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Merchant Dashboard URL ────────────────────────────────────────────────────
# Controls: Navbar CTAs (Login / Start Free Trial), PayBot redirect, homepage
# pricing CTAs. CRITICAL: set this before deploying to staging or production.
# Local:   http://localhost:4001
# Staging: https://dashboard.staging.paysurity.com
# Prod:    https://dashboard.paysurity.com
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:4001

# ── Notes ─────────────────────────────────────────────────────────────────────
# All other localhost references in the codebase use these two constants.
# There are NO other hardcoded localhost values remaining in production paths.
