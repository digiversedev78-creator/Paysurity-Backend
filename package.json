{
  "name": "@paysurity/platform",
  "version": "1.0.0",
  "description": "PaySurity Financial Platform - Complete merchant services, digital wallets, POS systems, and payroll",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "npm run validate && node dist/app.js",
    "start:dev": "tsx watch app.ts",
    "dev": "vite",
    "build": "vite build",
    "build:all": "pnpm -r run build",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit --reporter=verbose",
    "test:integration": "vitest run tests/integration --reporter=verbose",
    "test:security": "node Tests/runner.ts category security",
    "test:watch": "vitest",
    "migrate": "node scripts/migrate-database.js",
    "seed": "node scripts/seed-database.js",
    "lint": "pnpm -r run lint",
    "type-check": "tsc --noEmit",
    "clean": "pnpm -r run clean",
    "install:all": "pnpm install",
    "setup": "pnpm install && pnpm run build",
    "fix-configs": "powershell -ExecutionPolicy Bypass -File ./fix-typescript-configs.ps1",
    "setup-env": "powershell -ExecutionPolicy Bypass -File ./setup-environment.ps1",
    "build:prod": "tsc --build --clean && tsc --build",
    "compile": "tsc",
    "validate": "node scripts/validate_startup.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.5.0",
    "bcrypt": "^5.1.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.29.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.4",
    "paypal-rest-sdk": "^1.8.1",
    "pg": "^8.11.3",
    "redis": "^4.6.8",
    "socket.io": "^4.7.2",
    "stripe": "^13.5.0",
    "twilio": "^4.15.0",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/compression": "^1.7.2",
    "@types/cookie-parser": "^1.4.3",
    "@types/cors": "^2.8.13",
    "@types/crypto-js": "^4.1.1",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.5",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/lodash": "^4.14.195",
    "@types/moment": "^2.13.0",
    "@types/morgan": "^1.9.4",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.0",
    "@types/nodemailer": "^6.4.9",
    "@types/pg": "^8.10.2",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@types/redis": "^4.0.11",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.2.1",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^5.4.0"
  },
  "engines": {
    "node": ">=20.0.0 <21.0.0"
  },
  "packageManager": "pnpm@10.15.0"
}
