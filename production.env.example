# =============================================================================
# PaySurity Platform — Production Environment Variable Manifest
# =============================================================================
#
# INSTRUCTIONS:
#   1. Copy this file to `.env` (or inject these vars into your GCP Secret Manager
#      / Cloud Run environment) and fill in ALL blank values before deploying.
#   2. NEVER commit a populated version of this file to source control.
#   3. Values stored in GCP Secret Manager (recommended for P0 secrets) are
#      referenced in cloudbuild-staging.yaml via --set-secrets. Confirm parity.
#
# Classification:
#   [SECRET]  — Store in GCP Secret Manager. Never in plaintext env vars.
#   [BUILD]   — Baked into the Docker image at build time (NEXT_PUBLIC_* vars).
#   [RUNTIME] — Injected into the Cloud Run container at startup by GCP.
#   [OPS]     — Operational tuning; non-sensitive but required for correct behavior.
# =============================================================================


# ─── Node / Runtime ──────────────────────────────────────────────────────────
NODE_ENV=production

# Cloud Run injects PORT automatically. Do NOT hardcode this.
# PORT=8080   # [RUNTIME] — Managed by Cloud Run. Leave blank here.


# ─── Database (PostgreSQL / Cloud SQL) ───────────────────────────────────────
# [SECRET] Full Postgres connection string injected at runtime via Secret Manager.
DATABASE_URL=

# Individual components used by the Drizzle migration runner (packages/database).
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=        # [SECRET]
DATABASE_NAME=

# Cloud SQL Unix socket path (used when connecting via Cloud SQL Auth Proxy inside Cloud Run).
# Format: /cloudsql/PROJECT:REGION:INSTANCE_NAME
# DATABASE_SOCKET=/cloudsql/paysurity-platform-2026:us-central1:paysurity-prod


# ─── Authentication & JWT ─────────────────────────────────────────────────────
# [SECRET] Must be a cryptographically random string ≥ 64 chars.
# Generate: openssl rand -base64 64
JWT_SECRET=

# Token expiry — 24h recommended for merchant sessions.
JWT_EXPIRES_IN=24h

# MFA / TOTP settings (if applicable)
# MFA_ISSUER=PaySurity
# MFA_WINDOW=1


# ─── CORS & Network ───────────────────────────────────────────────────────────
# [RUNTIME] Comma-separated exact origins that the API will accept.
# Must include the exact Cloud Run dashboard URL (no trailing slash).
# Example: https://paysurity-dashboard-xxx.run.app,https://admin.paysurity.com
ALLOWED_ORIGINS=


# ─── Frontend (Next.js / merchant-dashboard) ─────────────────────────────────
# [BUILD] Baked into the Next.js bundle at docker build time.
# Must point to the public Cloud Run API service URL.
NEXT_PUBLIC_API_URL=

# Disables Next.js anonymous telemetry in all environments.
NEXT_TELEMETRY_DISABLED=1


# ─── Payment Gateways ────────────────────────────────────────────────────────
# FluidPay (primary card processing gateway)
FLUIDPAY_API_URL=https://app.fluidpay.com
FLUIDPAY_PRIVATE_KEY=     # [SECRET]
FLUIDPAY_PUBLIC_KEY=      # [SECRET]
FLUIDPAY_WEBHOOK_SECRET=  # [SECRET]

# Stripe (secondary / subscription billing)
STRIPE_SECRET_KEY=        # [SECRET]
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=    # [SECRET]

# Plaid (ACH / bank linking)
PLAID_CLIENT_ID=          # [SECRET]
PLAID_SECRET=             # [SECRET]
PLAID_ENV=production      # sandbox | development | production


# ─── AI / Generative Services ────────────────────────────────────────────────
GEMINI_API_KEY=           # [SECRET]
OPENAI_API_KEY=           # [SECRET] (if applicable)


# ─── Messaging & Notifications ────────────────────────────────────────────────
# SendGrid (transactional email)
SENDGRID_API_KEY=         # [SECRET]
SENDGRID_FROM_EMAIL=noreply@paysurity.com

# Twilio (SMS / MFA)
TWILIO_ACCOUNT_SID=       # [SECRET]
TWILIO_AUTH_TOKEN=        # [SECRET]
TWILIO_FROM_NUMBER=


# ─── Redis / Queue (BullMQ) ───────────────────────────────────────────────────
# [SECRET] Full Redis connection URL.
REDIS_URL=                # [SECRET]
# REDIS_TLS=true          # Uncomment if connecting to a TLS-enabled Redis instance


# ─── GCP Infrastructure ───────────────────────────────────────────────────────
GCP_PROJECT_ID=paysurity-platform-2026
GCP_REGION=us-central1

# Cloud Storage (for merchant asset uploads, KYB documents, etc.)
GCS_BUCKET_NAME=
GCS_SERVICE_ACCOUNT_KEY=  # [SECRET] Base64-encoded service account JSON, or use Workload Identity

# Google Maps (delivery / geolocation features)
GOOGLE_MAPS_API_KEY=      # [SECRET]


# ─── PCI / Compliance ────────────────────────────────────────────────────────
# Set to 'true' to enforce strict Fail-Closed PAN redaction (see pan-redaction.middleware.ts).
# Should always be 'true' in production.
PCI_STRICT_MODE=true

# Encryption key for at-rest PAN tokenization (AES-256 / KMS-managed).
# Prefer GCP KMS key references over raw values.
PAN_ENCRYPTION_KEY=       # [SECRET]


# ─── Feature Flags ────────────────────────────────────────────────────────────
# [OPS] Toggle experimental or staged-rollout features.
ENABLE_KDS_WEBSOCKETS=true
ENABLE_PAYFACTOR=true
ENABLE_GROCERY_VERTICAL=true
ENABLE_AFFILIATES=true


# ─── Logging & Observability ──────────────────────────────────────────────────
# [OPS] NestJS log level: error | warn | log | debug | verbose
LOG_LEVEL=log

# Sentry (error tracking — optional but strongly recommended pre-launch)
SENTRY_DSN=               # [SECRET]
SENTRY_ENVIRONMENT=production
