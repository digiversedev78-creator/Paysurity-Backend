
FROM node:20-alpine AS builder
WORKDIR /app
RUN npm install -g pnpm@9.15.4

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/consumer-storefront/ ./apps/consumer-storefront/

RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_API_URL=https://paysurity-api-44gyeebm6a-uc.a.run.app
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV GOOGLE_CLOUD_BUILD=true

WORKDIR /app/apps/consumer-storefront
RUN pnpm run build

# Stage 2: Runner
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=8080
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME="0.0.0.0"

RUN addgroup -g 1001 nodejs && adduser -D -u 1001 -G nodejs nextjs

# Copy standalone build output.
COPY --from=builder --chown=nextjs:nodejs /app/apps/consumer-storefront/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/consumer-storefront/.next/static ./apps/consumer-storefront/.next/static

USER nextjs
EXPOSE 8080

CMD ["node", "apps/consumer-storefront/server.js"]
