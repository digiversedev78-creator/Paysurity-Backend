# PaySurity-2026 — Environment Variables
# Copy to .env.local and fill in real values (never commit .env.local)

# ── App ──────────────────────────────────────────────────────────
# NODE_ENV: Application runtime environment (e.g., development, production, test).
# [REQUIRED]
NODE_ENV=development
# APP_ENVIRONMENT: High-level deployment environment (e.g., development, staging, production).
# [REQUIRED]
APP_ENVIRONMENT=development
# APP_VERSION: The current version of the application. Used for monitoring and identification.
# [OPTIONAL] (Can be derived from package.json)
APP_VERSION=0.0.1

# ── API Server ───────────────────────────────────────────────────
# API_PORT: The port on which the API server will listen.
# [REQUIRED]
API_PORT=4000
# API_HOST: The host address the API server will bind to.
# [REQUIRED]
API_HOST=0.0.0.0
# ALLOWED_ORIGINS: A comma-separated list of origins allowed to access the API (CORS).
# Example: http://localhost:4001,http://paysurity.dev:4001
# [REQUIRED]
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:4002,http://localhost:4003,http://localhost:4004,http://paysurity.dev:4001,http://merchant.paysurity.dev:4001

# ── Database (PostgreSQL 16 via Docker) ──────────────────────────
# DATABASE_HOST: The hostname or IP address of the PostgreSQL database server.
# [REQUIRED]
DATABASE_HOST=localhost
# DATABASE_PORT: The port of the PostgreSQL database server.
# [REQUIRED]
DATABASE_PORT=5436
# DATABASE_NAME: The name of the PostgreSQL database to connect to.
# [REQUIRED]
DATABASE_NAME=paysurity_dev
# DATABASE_USER: The username for connecting to the PostgreSQL database.
# [REQUIRED]
DATABASE_USER=paysurity
# DATABASE_PASSWORD: The password for the PostgreSQL database user.
# [REQUIRED]
DATABASE_PASSWORD=your_database_password
# DATABASE_URL: A full connection URL for the PostgreSQL database. If provided, it takes precedence.
# Example: postgresql://paysurity:your_database_password@localhost:5436/paysurity_dev
# [OPTIONAL] (Can be constructed from other DB vars)
DATABASE_URL=postgresql://paysurity:your_database_password@localhost:5436/paysurity_dev
# DATABASE_POOL_MIN: Minimum number of connections in the database pool.
# [OPTIONAL]
DATABASE_POOL_MIN=2
# DATABASE_POOL_MAX: Maximum number of connections in the database pool.
# [OPTIONAL]
DATABASE_POOL_MAX=10

# ── Redis ────────────────────────────────────────────────────────
# REDIS_HOST: The hostname or IP address of the Redis server.
# [REQUIRED]
REDIS_HOST=localhost
# REDIS_PORT: The port of the Redis server.
# [REQUIRED]
REDIS_PORT=6381
# REDIS_PASSWORD: The password for the Redis server (if authentication is enabled).
# [OPTIONAL]
REDIS_PASSWORD=your_redis_password
# REDIS_URL: A full connection URL for the Redis server. If provided, it takes precedence.
# Example: redis://your_redis_password@localhost:6381
# [OPTIONAL] (Can be constructed from other Redis vars)
REDIS_URL=redis://localhost:6381

# ── JWT Authentication ───────────────────────────────────────────
# JWT_SECRET: A strong, unguessable secret key used to sign JWTs.
# Generate a long random string (e.g., using `openssl rand -base64 32`).
# [REQUIRED]
JWT_SECRET=super_secret_jwt_key_that_is_at_least_32_characters_long
# JWT_ACCESS_TOKEN_EXPIRATION: Expiration time for access tokens (e.g., 15m, 1h, 7d).
# [REQUIRED]
JWT_ACCESS_TOKEN_EXPIRATION=15m
# JWT_REFRESH_TOKEN_EXPIRATION: Expiration time for refresh tokens (e.g., 7d, 30d).
# [REQUIRED]
JWT_REFRESH_TOKEN_EXPIRATION=7d
# JWT_AUDIENCE: The audience claim ('aud') for JWTs.
# [OPTIONAL]
JWT_AUDIENCE=https://api.paysurity.com
# JWT_ISSUER: The issuer claim ('iss') for JWTs.
# [OPTIONAL]
JWT_ISSUER=https://paysurity.com

# ── Logging ──────────────────────────────────────────────────────
# LOG_LEVEL: The minimum level of logs to display (e.g., debug, info, warn, error).
# [OPTIONAL]
LOG_LEVEL=info
# LOG_PRETTY_PRINT: Enable pretty printing for logs (useful in development).
# [OPTIONAL]
LOG_PRETTY_PRINT=true

# ── Telemetry (OpenTelemetry) ────────────────────────────────────
# OPENTELEMETRY_ENABLED: Enable OpenTelemetry for tracing and metrics.
# [OPTIONAL]
OPENTELEMETRY_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT: The endpoint for the OTLP collector.
# Example: http://localhost:4317
# [OPTIONAL]
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Payment Gateways ─────────────────────────────────────────────
# STRIPE_SECRET_KEY: Stripe API secret key for payment processing.
# [OPTIONAL]
STRIPE_SECRET_KEY=sk_test_****************************************
# STRIPE_WEBHOOK_SECRET: Stripe webhook signing secret for verifying events.
# [OPTIONAL]
STRIPE_WEBHOOK_SECRET=whsec_****************************************
# PAYPAL_CLIENT_ID: PayPal API client ID.
# [OPTIONAL]
PAYPAL_CLIENT_ID=your_paypal_client_id
# PAYPAL_SECRET: PayPal API secret.
# [OPTIONAL]
PAYPAL_SECRET=your_paypal_secret
# PAYSURITY_PRIMARY_PAYMENT_GATEWAY_API_KEY: A generic API key for Paysurity's primary payment processor integration.
# [OPTIONAL]
PAYSURITY_PRIMARY_PAYMENT_GATEWAY_API_KEY=paysurity_gateway_api_key

# ── Notifications (Email & SMS) ──────────────────────────────────
# SENDGRID_API_KEY: API Key for SendGrid production email delivery.
# [REQUIRED]
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
# TWILIO_ACCOUNT_SID: Twilio Account SID for SMS delivery.
# [REQUIRED]
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
# TWILIO_AUTH_TOKEN: Twilio Auth Token.
# [REQUIRED]
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_FROM_NUMBER: Twilio verified phone number.
# [REQUIRED]
TWILIO_FROM_NUMBER=+1234567890
# MAIL_FROM: Default sender email address.
# [OPTIONAL]
MAIL_FROM=no-reply@paysurity.com

# ── File Storage (S3 Compatible) ─────────────────────────────────
# S3_ENDPOINT: Custom S3 compatible endpoint (e.g., for MinIO or other providers).
# Example: http://localhost:9000
# [OPTIONAL]
S3_ENDPOINT=
# S3_REGION: AWS S3 region (e.g., us-east-1).
# [OPTIONAL]
S3_REGION=us-east-1
# S3_ACCESS_KEY_ID: S3 access key ID.
# [OPTIONAL]
S3_ACCESS_KEY_ID=your_s3_access_key_id
# S3_SECRET_ACCESS_KEY: S3 secret access key.
# [REQUIRED]
S3_SECRET_ACCESS_KEY=your_s3_secret_access_key
# S3_BUCKET_NAME: The name of the S3 bucket to use.
# [REQUIRED]
S3_BUCKET_NAME=paysurity-storage

# ── Encryption ───────────────────────────────────────────────────
# ENCRYPTION_KEY: A secret key used for encrypting sensitive data at rest (e.g., tenant-specific configs).
# Must be 32 bytes for AES-256.
# [REQUIRED]
ENCRYPTION_KEY=a_very_long_and_secret_encryption_key_32_bytes_long

# ── Tenant Management ────────────────────────────────────────────
# DEFAULT_TENANT_ID: The UUID of the default or system tenant, used for global operations or when no tenant context is available.
# [OPTIONAL]
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
---
# PaySurity-2026 — API Application Environment Variables
