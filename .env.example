---
# PaySurity-2026 — Test Environment Variables
# This file contains test-safe values for running Jest tests.
# Values here should be predictable, isolated, and not interfere with development environments.

# ── App ──────────────────────────────────────────────────────────
NODE_ENV=test
APP_ENVIRONMENT=test
APP_VERSION=test

# ── API Server ───────────────────────────────────────────────────
# Use port 0 to allow the OS to assign an ephemeral port, preventing conflicts during parallel tests.
API_PORT=0
API_HOST=127.0.0.1
ALLOWED_ORIGINS=http://localhost:4001,http://localhost:4002

# ── Database (PostgreSQL 16 via Docker) ──────────────────────────
DATABASE_HOST=localhost
DATABASE_PORT=5437
DATABASE_NAME=paysurity_test
DATABASE_USER=paysurity_test
DATABASE_PASSWORD=test_password
DATABASE_URL=postgresql://paysurity_test:test_password@localhost:5437/paysurity_test
DATABASE_POOL_MIN=1
DATABASE_POOL_MAX=2

# ── Redis ────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6383
REDIS_PASSWORD=test_redis_password
REDIS_URL=redis://localhost:6383

# ── JWT Authentication ───────────────────────────────────────────
JWT_SECRET=super_secret_test_key_for_jwt
JWT_ACCESS_TOKEN_EXPIRATION=1h
JWT_REFRESH_TOKEN_EXPIRATION=7d
JWT_AUDIENCE=test-audience
JWT_ISSUER=test-issuer

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=warn
LOG_PRETTY_PRINT=false

# ── Telemetry (OpenTelemetry) ────────────────────────────────────
OPENTELEMETRY_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ── Payment Gateways ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_MOCK_STRIPE_KEY_FOR_TESTING
STRIPE_WEBHOOK_SECRET=whsec_MOCK_WEBHOOK_SECRET_FOR_TESTING
PAYPAL_CLIENT_ID=test_paypal_client_id
PAYPAL_SECRET=test_paypal_secret
PAYSURITY_PRIMARY_PAYMENT_GATEWAY_API_KEY=test_paysurity_gateway_api_key

# ── Email Service (SMTP) ─────────────────────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025 # MailHog or similar
MAIL_USER=test_mail_user
MAIL_PASSWORD=test_mail_password
MAIL_FROM=test@paysurity.com

# ── File Storage (S3 Compatible) ─────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test_s3_access_key
S3_SECRET_ACCESS_KEY=test_s3_secret_key
S3_BUCKET_NAME=paysurity-test-storage

# ── Encryption ───────────────────────────────────────────────────
ENCRYPTION_KEY=a_short_test_encryption_key_32bytes_!!

# ── Tenant Management ────────────────────────────────────────────
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000